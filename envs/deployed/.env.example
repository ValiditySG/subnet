# One operator, one host, one hotkey. Copy to .env; chmod 600 .env.
# Validity testnet subnet 568. Complete this operator's fields before startup.
VALIDATOR_IMAGE=
VALIDATOR_NETUID=568
VALIDATOR_CHAIN_GENESIS=0x8f9cf856bf558a14440e75569c9e58594757048d7b3a84b5d25f6bd978263105
VALIDATOR_TEMPO=
VALIDATOR_NETWORK=test
VALIDATOR_MODE=synthetic
# Set this operator's wallet and hotkey after registration.
VALIDATOR_WALLET_NAME=
VALIDATOR_HOTKEY_NAME=
HOST_WALLET_DIR=
HOST_TLS_DIR=
# Installer generates distinct random tokens below.
VALIDATOR_PYLON_OPEN_ACCESS_TOKEN=
VALIDATOR_PYLON_IDENTITY_TOKEN=
PYLON_METRICS_TOKEN=
# Dedicated ACL token for this operator, with PUT and GET access.
HIPPIUS_BUCKET=validity-testnet
HIPPIUS_ACCESS_KEY_ID=
HIPPIUS_SECRET_ACCESS_KEY=
HIPPIUS_VERIFY_READBACK=true
