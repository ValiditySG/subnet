# One operator, one hotkey. Use installer/install.sh; keep .env at mode 0600.
# See docs/validator.md for Docker vs manual requirements. Never commit secrets.
# Docker-only REQUIRED image references; unused by the Python validator.
VALIDATOR_IMAGE=
PYLON_IMAGE=
# OPTIONAL: defaults to 568 in both launch modes.
VALIDATOR_NETUID=568
# REQUIRED in both modes; the supported testnet genesis is provided here.
VALIDATOR_CHAIN_GENESIS=0x8f9cf856bf558a14440e75569c9e58594757048d7b3a84b5d25f6bd978263105
# REQUIRED: set the actual on-chain tempo. No default.
VALIDATOR_TEMPO=
# OPTIONAL for manual runs; Compose fixes these values.
VALIDATOR_NETWORK=test
VALIDATOR_MODE=synthetic
# REQUIRED for manual runs; Compose supplies its own address and identity name.
VALIDATOR_PYLON_SERVICE_ADDRESS=http://127.0.0.1:8000
VALIDATOR_PYLON_IDENTITY_NAME=validator
# OPTIONAL manual path: relative to the working directory, not this file.
# Compose fixes /var/lib/validity/credentials.sqlite3 in its private state volume.
VALIDATOR_LEDGER_PATH=./state/credentials.sqlite3
# OPTIONAL for manual runs; Compose fixes true. No tracing endpoint is configured.
OTEL_SDK_DISABLED=true
# OPTIONAL: standard Bittensor wallet defaults. Select an existing signing hotkey.
# Compose mounts this host directory read-only at /wallets. Exclude private coldkeys.
VALIDATOR_WALLET_PATH=~/.bittensor/wallets
VALIDATOR_WALLET_NAME=default
VALIDATOR_HOTKEY_NAME=default
# REQUIRED in both modes: must match Pylon. Installer generates distinct tokens.
VALIDATOR_PYLON_OPEN_ACCESS_TOKEN=
VALIDATOR_PYLON_IDENTITY_TOKEN=
# REQUIRED by Compose; unused by Python. Also used by the standalone Pylon recipe.
PYLON_METRICS_TOKEN=
# OPTIONAL, default true. false disables publishing for chain-only tests.
HIPPIUS_ENABLED=true
# REQUIRED even when publishing is disabled: recovery destination binding.
HIPPIUS_BUCKET=validity-testnet
# CONDITIONALLY REQUIRED when HIPPIUS_ENABLED=true. Dedicated per-operator ACL pair.
# Leave empty only when HIPPIUS_ENABLED=false; no ambient AWS fallback is used.
HIPPIUS_ACCESS_KEY_ID=
HIPPIUS_SECRET_ACCESS_KEY=
# OPTIONAL, default true in both modes.
HIPPIUS_VERIFY_READBACK=true
