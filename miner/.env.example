# Copy to .env under umask 077; never commit real credentials.
MINER_NETWORK=test
MINER_CHAIN_GENESIS=0x8f9cf856bf558a14440e75569c9e58594757048d7b3a84b5d25f6bd978263105
MINER_NETUID=568
MINER_WALLET_PATH=/absolute/path/to/wallets
# Select this instance's registered wallet and hotkey.
MINER_WALLET_NAME=
MINER_HOTKEY_NAME=
MINER_ALLOWED_VALIDATORS=[]
MINER_PYLON_ADDRESS=http://127.0.0.1:8000
MINER_PYLON_OPEN_ACCESS_TOKEN=
MINER_TLS_CA_FILE=/absolute/path/to/tls/ca.pem
MINER_TLS_CERT_FILE=/absolute/path/to/tls/server.pem
MINER_TLS_KEY_FILE=/absolute/path/to/tls/server-key.pem
MINER_JOURNAL_PATH=./state/requests.sqlite3
MINER_PORT=8443
MINER_SOURCE_VERSION=v1
MINER_REQUESTS_PER_MINUTE=120
# Compose-only configuration. Use a released image by registry digest.
MINER_IMAGE=
HOST_MINER_WALLET_DIR=
HOST_MINER_TLS_DIR=
PYLON_METRICS_TOKEN=
