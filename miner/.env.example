# Copy to .env under umask 077; chmod 600 .env. Never commit secrets.
# See docs/miner.md for Docker vs manual requirements and token preparation.
# OPTIONAL for manual runs; Compose fixes test.
MINER_NETWORK=test
# REQUIRED in both modes; the supported testnet genesis is provided here.
MINER_CHAIN_GENESIS=0x8f9cf856bf558a14440e75569c9e58594757048d7b3a84b5d25f6bd978263105
# OPTIONAL, default 568 in both modes.
MINER_NETUID=568
# OPTIONAL: standard Bittensor wallet defaults. Select an existing signing hotkey.
# Compose mounts this host directory read-only at /wallets. Exclude private coldkeys.
MINER_WALLET_PATH=~/.bittensor/wallets
MINER_WALLET_NAME=default
MINER_HOTKEY_NAME=default
# REQUIRED in both modes: a nonempty JSON array of actual validator hotkeys.
# [] is a placeholder and is rejected at runtime.
MINER_ALLOWED_VALIDATORS=[]
# REQUIRED for manual runs; Compose fixes http://pylon:8000 instead.
MINER_PYLON_ADDRESS=http://127.0.0.1:8000
# REQUIRED in both modes: must match Pylon's open-access token.
MINER_PYLON_OPEN_ACCESS_TOKEN=
# OPTIONAL manual path: relative to the working directory, not this file.
# Compose fixes /var/lib/validity-miner/requests.sqlite3 in its private state volume.
MINER_JOURNAL_PATH=./state/requests.sqlite3
# OPTIONAL, default 8080. Host port in Compose; listening port in manual mode.
MINER_PORT=8080
# OPTIONAL, default v1. Supports v1 or v2; match the agreed dataset rollout.
MINER_SOURCE_VERSION=v1
# OPTIONAL, default 120 per validator; range 1-1000.
MINER_REQUESTS_PER_MINUTE=120
# Docker-only REQUIRED image references; unused by the Python miner.
MINER_IMAGE=
PYLON_IMAGE=
# REQUIRED by Compose; unused by Python. Also used by the standalone Pylon recipe.
PYLON_METRICS_TOKEN=
