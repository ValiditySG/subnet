# Run from validator/. Copy to localnet/state/score-service.env (gitignored).
# Local test storage is only for development transport tests.
# This file configures the development harness, not a production validator deployment.
# Hippius integration tests must explicitly use HIPPIUS_BACKEND=hippius and real bucket access.
# SQLite remains private to each validator; it is never shared report storage.
HIPPIUS_BACKEND=local
HIPPIUS_HOST=127.0.0.1
HIPPIUS_PORT=8090
HIPPIUS_LOCAL_DIRECTORY=../localnet/state/score-objects
HIPPIUS_NETUID=2
VALIDATOR_OTEL_DEPLOYMENT_ENVIRONMENT=localnet
VALIDATOR_OTEL_SERVICE_NAME=score-service

# Required: replace with actual public localnet values.
# HIPPIUS_CHAIN_GENESIS=0x...
# HIPPIUS_VALIDATORS=["validator-hotkey-address"]

# For verified Hippius reads: set backend=hippius and supply a READ/LIST credential profile.
# Hippius mode disables HTTP uploads; validators upload directly with their own ACL credentials.
# Test bucket, credential path and GET/LIST access are confirmed.
# HIPPIUS_BUCKET=localnet
# HIPPIUS_CREDENTIALS_FILE=../localnet/hippius-credentials.json
# HIPPIUS_PROFILE=owner
