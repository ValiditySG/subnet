# Copy into this validator's private deployment configuration. Do not commit real credentials.
# Configure each of the three validators independently using the mapping in docs/score-reporting.md.
VALIDATOR_MODE=local_credentials
NETUID=2
SUBNET_TEMPO=360
VALIDATOR_FIXTURE_DIR=../localnet/fixtures
VALIDATOR_LEDGER_PATH=../localnet/state/credentials.sqlite3
VALIDATOR_CALLBACK_HOST=127.0.0.1
VALIDATOR_CALLBACK_PORT=8001

# Keep this validator's existing sidecar URL, identity and token settings in its private .env.
# VALIDATOR_PYLON_SERVICE_ADDRESS=
# VALIDATOR_PYLON_OPEN_ACCESS_TOKEN=
# VALIDATOR_PYLON_IDENTITY_NAME=
# VALIDATOR_PYLON_IDENTITY_TOKEN=

VALIDATOR_REPORTS_ENABLED=true
VALIDATOR_REPORTS_BACKEND=hippius
# Required: actual public local-chain genesis hash. Test bucket confirmed by the user.
# VALIDATOR_REPORTS_CHAIN_GENESIS=0x...
VALIDATOR_REPORTS_BUCKET=localnet
# Private JSON file; profile selects one team's ACL access key ID and secret.
# Relative paths here resolve from validator/. Bucket-wide WRITE access was confirmed.
VALIDATOR_REPORTS_CREDENTIALS_FILE=../localnet/hippius-credentials.json
VALIDATOR_REPORTS_PROFILE=validator-1
VALIDATOR_REPORTS_WALLET_PATH=../localnet/wallets
VALIDATOR_REPORTS_WALLET_NAME=validator
VALIDATOR_REPORTS_HOTKEY_NAME=default

# WRITE-only tokens work with false. A separate READ/LIST identity verifies signatures later.
# Set true only if this profile can also GET its uploaded objects.
VALIDATOR_REPORTS_VERIFY_READBACK=false
VALIDATOR_REPORTS_TIMEOUT_SECONDS=10
VALIDATOR_OTEL_DEPLOYMENT_ENVIRONMENT=localnet
