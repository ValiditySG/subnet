
# Bootstrap script will register a subnet, and netuid 1 is preoccupied and unusable, hence we end up with netuid 2
NETUID=2

# Local chain, sidecar and validator must use the same epoch length in blocks.
SUBNET_TEMPO=360

# Validator connection to pylon
VALIDATOR_PYLON_SERVICE_ADDRESS=http://localhost:8000
VALIDATOR_PYLON_OPEN_ACCESS_TOKEN=localnet-open-access-token
VALIDATOR_PYLON_IDENTITY_NAME=validator
VALIDATOR_PYLON_IDENTITY_TOKEN=localnet-validator-token

# Pretty, colored console logs for local development (production defaults to JSON)
VALIDATOR_LOGGING_FORMAT=console
# Root log level; set to DEBUG for verbose dev logging
VALIDATOR_LOGGING_ROOT_LEVEL=INFO

# Local RN evaluation, scoring and weights; use 'ping' with the original echo miner for baseline testing.
VALIDATOR_MODE=local_credentials
VALIDATOR_FIXTURE_DIR=../localnet/fixtures
VALIDATOR_LEDGER_PATH=../localnet/state/credentials.sqlite3
VALIDATOR_OTEL_DEPLOYMENT_ENVIRONMENT=localnet

# Latest completed round must be no more than ten minutes old.
VALIDATOR_MAX_SCORE_AGE=PT10M
VALIDATOR_MAX_IN_FLIGHT=4

# Optional development gateway test. Real Hippius tests use the per-validator examples.
VALIDATOR_REPORTS_ENABLED=false
VALIDATOR_REPORTS_BACKEND=gateway
VALIDATOR_REPORTS_GATEWAY_URL=http://127.0.0.1:8090
# Set the actual local chain genesis hash before enabling publishing.
# VALIDATOR_REPORTS_CHAIN_GENESIS=0x...
VALIDATOR_REPORTS_WALLET_PATH=../localnet/wallets
VALIDATOR_REPORTS_WALLET_NAME=validator
VALIDATOR_REPORTS_HOTKEY_NAME=default
