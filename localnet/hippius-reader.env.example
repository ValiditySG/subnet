# Reader only: no validator hotkey secret or upload credentials are needed here.
# Copy to localnet/state/hippius-reader.env and fill actual values before use.
HIPPIUS_BACKEND=hippius
HIPPIUS_NETUID=2
HIPPIUS_HOST=127.0.0.1
HIPPIUS_PORT=8090
# Test bucket confirmed by the user; actual genesis is still required.
HIPPIUS_BUCKET=localnet
# HIPPIUS_CHAIN_GENESIS=0x...
# Required: the three expected public validator hotkeys (JSON array).
# HIPPIUS_VALIDATORS=["hotkey-1","hotkey-2","hotkey-3"]
# The owner profile is also used by test validator 3, as confirmed by the user.
# All three test profiles have passed GET/LIST checks; production readers need their own READ access.
HIPPIUS_CREDENTIALS_FILE=../localnet/hippius-credentials.json
HIPPIUS_PROFILE=owner
VALIDATOR_OTEL_DEPLOYMENT_ENVIRONMENT=localnet
VALIDATOR_OTEL_SERVICE_NAME=score-reader
